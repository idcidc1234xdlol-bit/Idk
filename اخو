local safePos = nil

local function applyFloat()
    local char = L.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.HipHeight = 25 end
end

local function findSafeZone()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("SpawnLocation") then
            return obj.Position + Vector3.new(0, 6, 0)
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("safe") or n:find("base") or n:find("spawn") then
                return obj.Position + Vector3.new(0, 6, 0)
            end
        end
    end
    return Vector3.new(0, 10, 0)
end

local function goToSafeZone()
    local char = L.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    safePos = findSafeZone()
    hrp.CFrame = CFrame.new(safePos)
end

local function lockCharacter()
    local char = L.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum then
        hum.HipHeight = 25
        pcall(function() hum.MaxHealth = math.huge end)
        pcall(function() hum.Health    = math.huge end)
    end
    if hrp and hrp.Position.Y < -30 and safePos then
        hrp.CFrame = CFrame.new(safePos)
    end
end

local function onSpawn()
    task.wait(0.5)
    safePos = findSafeZone()
    applyFloat()
    goToSafeZone()
    task.wait(1)
    lockCharacter()
end

if L.Character then task.spawn(onSpawn) end
L.CharacterAdded:Connect(onSpawn)

RunService.Heartbeat:Connect(function()
    local char = L.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hum then
        if hum.HipHeight < 25 then hum.HipHeight = 25 end
        pcall(function()
            if hum.Health < hum.MaxHealth * 0.5 then
                hum.Health = hum.MaxHealth
            end
        end)
    end
    if hrp then
        if hrp.Position.Y < -30 and safePos then
            hrp.CFrame = CFrame.new(safePos)
        end
    end
end)

