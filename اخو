local lastEquipped = nil

local function getEquippedTool()
    local char = L.Character
    if not char then return nil end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then return v end
    end
    return nil
end

local function autoEquip()
    local char = L.Character
    if not char then return end
    local tool = getEquippedTool()
    if tool then
        lastEquipped = tool
        return
    end
    local bp = L:FindFirstChild("Backpack")
    if not bp then return end
    local target = lastEquipped and bp:FindFirstChild(lastEquipped.Name)
                or bp:FindFirstChildOfClass("Tool")
    if target then
        if not lastEquipped then lastEquipped = target end
        target.Parent = char
    end
end

task.spawn(function()
    while true do
        task.wait(0.4)
        autoEquip()
    end
end)

ShardDrop.OnClientEvent:Connect(function(shardData)
    local id
    if type(shardData) == "number" then id = shardData
    elseif type(shardData) == "table" then id = shardData.ZombieId or shardData.Id or shardData[1]
    elseif type(shardData) == "userdata" then id = shardData:GetAttribute("ZombieId") or shardData:GetAttribute("Id") end
    pcall(ShardCollect.FireServer, ShardCollect, id or shardData)
end)

RainDrop.OnClientEvent:Connect(function(rainData)
    local id
    if type(rainData) == "number" then id = rainData
    elseif type(rainData) == "table" then id = rainData.RainId or rainData.Id or rainData[1]
    elseif type(rainData) == "userdata" then id = rainData:GetAttribute("RainId") or rainData:GetAttribute("Id") end
    pcall(RainCollect.FireServer, RainCollect, id or rainData)
end)

