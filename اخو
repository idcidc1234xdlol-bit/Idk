local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService  = game:GetService("UserInputService")
local L                 = Players.LocalPlayer

local ZombieRemotes = ReplicatedStorage:WaitForChild("ZombieRemotes")
local EventRemotes  = ReplicatedStorage:WaitForChild("EventRemotes")
local RainRemotes   = ReplicatedStorage:WaitForChild("RainRemotes")

local D            = ZombieRemotes:WaitForChild("ZombieDamage")
local ShardCollect = EventRemotes:WaitForChild("GalacticShardCollect")
local ShardDrop    = EventRemotes:WaitForChild("GalacticShardDrop")
local RainCollect  = RainRemotes:WaitForChild("RainCollect")
local RainDrop     = RainRemotes:WaitForChild("RainDrop")
local VIM          = game:GetService("VirtualInputManager")
local mouse        = L:GetMouse()

local Z
local ok, res = pcall(function()
    return require(L.PlayerScripts.Controllers.ZombieClient).Zombies
end)
if ok and type(res) == "table" then Z = res end
if not Z then
    for _, v in pairs(getgc(true)) do
        if type(v) == "table" and rawget(v, "Zombies") and rawget(v, "ZombieModels") then
            Z = v.Zombies
            break
        end
    end
end

local Flags = {
    KillAura    = false,
    AutoCollect = false,
    Float       = false,
    AntiAFK     = false,
    AutoEquip   = false,
}

local lastEquipped = nil

local function applyFloat()
    local char = L.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.HipHeight = 25 end
end

L.CharacterAdded:Connect(function()
    task.wait(1)
    if Flags.Float then applyFloat() end
end)

-- Kill Aura: نفس منطق V1 بالظبط
task.spawn(function()
    while task.wait(0.2) do
        if Flags.Float then applyFloat() end

        if Flags.KillAura and Z then
            for id, data in pairs(Z) do
                if data and not data.IsDying and data.Health > 0 then
                    D:FireServer(id, math.huge)
                end
            end
        end
    end
end)

-- Auto Equip
task.spawn(function()
    while true do
        task.wait(0.3)
        if not Flags.AutoEquip then continue end
        local char = L.Character
        if not char then continue end
        local hasTool = false
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then lastEquipped = v hasTool = true break end
        end
        if not hasTool then
            local bp = L:FindFirstChild("Backpack")
            if bp then
                local target = lastEquipped and bp:FindFirstChild(lastEquipped.Name)
                            or bp:FindFirstChildOfClass("Tool")
                if target then
                    if not lastEquipped then lastEquipped = target end
                    target.Parent = char
                end
            end
        end
    end
end)

-- Auto Collect
ShardDrop.OnClientEvent:Connect(function(shardData)
    if not Flags.AutoCollect then return end
    local id
    if type(shardData) == "number" then id = shardData
    elseif type(shardData) == "table" then id = shardData.ZombieId or shardData.Id or shardData[1]
    elseif type(shardData) == "userdata" then id = shardData:GetAttribute("ZombieId") or shardData:GetAttribute("Id") end
    pcall(ShardCollect.FireServer, ShardCollect, id or shardData)
end)

RainDrop.OnClientEvent:Connect(function(rainData)
    if not Flags.AutoCollect then return end
    local id
    if type(rainData) == "number" then id = rainData
    elseif type(rainData) == "table" then id = rainData.RainId or rainData.Id or rainData[1]
    elseif type(rainData) == "userdata" then id = rainData:GetAttribute("RainId") or rainData:GetAttribute("Id") end
    pcall(RainCollect.FireServer, RainCollect, id or rainData)
end)

-- Anti AFK
task.spawn(function()
    local ok2, SG = pcall(function() return game:GetService("StarterGui") end)
    while true do
        task.wait(1)
        if not Flags.AntiAFK then continue end
        task.wait(16 + math.random() * 6)
        pcall(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam.CFrame = cam.CFrame * CFrame.Angles(
                    (math.random()-0.5)*0.004,
                    (math.random()-0.5)*0.004, 0)
            end
        end)
        pcall(function()
            local cx, cy = mouse.X, mouse.Y
            VIM:SendMouseMoveEvent(cx+math.random(-5,5), cy+math.random(-5,5), game)
            task.wait(0.06)
            VIM:SendMouseMoveEvent(cx, cy, game)
        end)
        pcall(function()
            VIM:SendKeyEvent(true,  Enum.KeyCode.W, false, game)
            task.wait(0.05+math.random()*0.04)
            VIM:SendKeyEvent(false, Enum.KeyCode.W, false, game)
        end)
        pcall(function()
            local char = L.Character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Jump = true task.wait(0.07) hum.Jump = false end
        end)
        pcall(function()
            local tt = UserInputService:FindFirstChildOfClass("TouchTransmitter")
            if tt then
                tt:Transmit(Vector2.new(math.random(100,700), math.random(100,500)),
                    Enum.UserInputType.Touch, Enum.UserInputState.Begin, game)
                task.wait(0.04)
                tt:Transmit(Vector2.new(math.random(100,700), math.random(100,500)),
                    Enum.UserInputType.Touch, Enum.UserInputState.End, game)
            end
        end)
        pcall(function()
            if ok2 and SG then SG:SetCore("ResetButtonCallback", true) end
        end)
    end
end)

